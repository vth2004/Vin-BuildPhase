# Copy to .deploy.env and fill in the real values. Never commit .deploy.env.

# SSH target
VPS_HOST=103.72.56.152
VPS_USER=root
SSH_KEY=~/.ssh/id_ed25519
REMOTE_DIR=/opt/vin-buildphase

# Coolify (its own API listens on :8000 on the VPS)
COOLIFY_URL=http://103.72.56.152:8000
COOLIFY_SERVICE_UUID=
# Quote the value: Coolify tokens contain a pipe (id|secret).
COOLIFY_TOKEN=''

# Public URLs served by the Coolify proxy
PUBLIC_FRONTEND_URL=http://landmarkqa.duckdns.org
PUBLIC_BACKEND_URL=http://landmarkqabe.duckdns.org

# auto = upload models only when missing on the VPS (default), true = always, false = never
SYNC_MODELS=auto

# How long to wait for the Coolify deployment to become reachable
DEPLOY_TIMEOUT_SECONDS=1800
DEPLOY_POLL_SECONDS=10
